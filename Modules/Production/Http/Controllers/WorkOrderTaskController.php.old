public function startTimer(Request $request, WorkOrderTask $task)
{
$request->validate(['employee_id' => 'required|exists:employees,id']);
// Close any running timer for this employee on this task
TaskTimeLog::where('task_id',$task->id)->where('employee_id',$request->employee_id)->whereNull('ended_at')
->update(['ended_at' => now(), 'minutes' => DB::raw('TIMESTAMPDIFF(MINUTE, started_at, NOW())')]);


$log = TaskTimeLog::create([
'task_id' => $task->id,
'employee_id' => $request->employee_id,
'started_at' => now(),
]);


if ($task->status === 'pending') { $task->update(['status' => 'in_progress', 'started_at' => now()]); }


return response()->json(['success' => true, 'log_id' => $log->id]);
}


public function stopTimer(Request $request, WorkOrderTask $task)
{
$request->validate(['employee_id' => 'required|exists:employees,id']);
$log = TaskTimeLog::where('task_id',$task->id)->where('employee_id',$request->employee_id)->whereNull('ended_at')->latest('started_at')->firstOrFail();
$log->update(['ended_at' => now(), 'minutes' => now()->diffInMinutes($log->started_at)]);


$task->update(['actual_minutes' => $task->timeLogs()->sum('minutes')]);


return response()->json(['success' => true]);
}


public function complete(Request $request, WorkOrderTask $task)
{
// Ensure all required checklist items are checked
$requiredOpen = $task->checklistItems()->where('is_required', true)->where('is_checked', false)->count();
if ($requiredOpen > 0) {
return response()->json(['success' => false, 'message' => 'Complete required checklist items first.'], 422);
}
$task->update(['status' => 'completed', 'completed_at' => now()]);
return response()->json(['success' => true]);
}
}